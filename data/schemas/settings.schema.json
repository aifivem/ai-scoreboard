{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-scoreboard/data/settings.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    },
    "showNames": {
      "description": "Show names: Character names of everyone online.",
      "type": "boolean"
    },
    "showIds": {
      "description": "Show ids: The server id of each player.",
      "type": "boolean"
    },
    "jobs": {
      "description": "Jobs",
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "job": {
            "description": "Job",
            "type": "string",
            "minLength": 2,
            "maxLength": 32,
            "pattern": "^[a-z0-9_]{2,32}$"
          },
          "label": {
            "description": "Shown as",
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "required": [
          "job",
          "label"
        ]
      }
    }
  },
  "required": [
    "showNames",
    "showIds",
    "jobs"
  ]
}
